{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KaïroOS",
  "version": "26.1.0",
  "identifier": "com.kairo.os",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../.live/builds/frontend/current"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KaïroOS — Arcade Frontend",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*",
          "$APPDATA/**/*",
          "$HOME/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": true
      }
    },
    "resources": [],
    "externalBin": []
  }
}
