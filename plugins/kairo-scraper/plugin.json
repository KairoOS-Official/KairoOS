{
  "id": "kairo-scraper",
  "name": "KaïroOS Auto Scraper Pro",
  "version": "1.0.0",
  "author": "KaïroOS Team",
  "type": "official",
  "description": "Scraping automatique et par lot des jaquettes, médias et métadonnées via ScreenScraper API",
  "min_kairo_version": "0.1.0",
  "permissions": [
    "network",
    "read_games",
    "write_games",
    "read_settings",
    "write_settings"
  ],
  "entry": "index.js",
  "ui": "dist/index.html",
  "commands": ["start_batch", "stop_batch", "status"],
  "contributes": {
    "to": ["kairo-remote"],
    "remote_nav_item": {
      "id": "kairo-scraper",
      "label": "Auto Scraper",
      "icon": "globe",
      "badge": "Pro",
      "url": "/plugins/kairo-scraper/dist/index.html"
    },
    "remote_settings_page": {
      "title": "Configuration Scraping",
      "entry": "dist/index.html"
    }
  },
  "settings_section": {
    "label": "Scraping",
    "icon": "globe"
  },
  "settings_schema": {
    "screenscraper_user": {
      "type": "string",
      "default": "",
      "label": "Identifiant ScreenScraper"
    },
    "screenscraper_pass": {
      "type": "string",
      "default": "",
      "secret": true,
      "label": "Mot de passe ScreenScraper"
    },
    "download_covers": {
      "type": "boolean",
      "default": true,
      "label": "Télécharger les jaquettes"
    },
    "download_backdrops": {
      "type": "boolean",
      "default": true,
      "label": "Télécharger les fonds d'écran (Backdrops)"
    },
    "download_videos": {
      "type": "boolean",
      "default": false,
      "label": "Télécharger les vidéos / trailers"
    },
    "language": {
      "type": "string",
      "default": "fr",
      "label": "Langue des métadonnées (fr, en)"
    }
  }
}
