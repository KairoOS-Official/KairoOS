{
  "id": "kairo-hub",
  "name": "Kaïro Hub (Plein Écran & Catégories)",
  "author": "Flow (Florian) — FlowCreativeStudio",
  "version": "1.0.0",
  "description": "Thème moderne plein écran sans sidebar, avec navigation par rayons horizontaux (Consoles, Modes, Sagas, Favoris)",
  "theme_type": "built-in",
  "layout_type": "single_page_categories",
  "colors": {
    "bg_primary": "#0e131f",
    "bg_secondary": "#151d2f",
    "bg_card": "#1d273f",
    "sidebar_bg": "#121929",
    "accent_primary": "#6366f1",
    "accent_secondary": "#ec4899",
    "text_primary": "#f8fafc",
    "text_secondary": "#94a3b8",
    "text_muted": "#64748b",
    "border": "#283553",
    "success": "#10b981",
    "warning": "#f59e0b",
    "danger": "#ef4444"
  },
  "fonts": {
    "primary": "Outfit, Inter, system-ui, sans-serif",
    "arcade": "Press Start 2P, monospace",
    "size_base": "14px"
  },
  "layout": {
    "card_radius": "20px",
    "sidebar_width": "280px",
    "card_gap": "16px",
    "card_aspect": "poster",
    "card_glow": "neon",
    "scanlines": "none",
    "card_shadow": "soft",
    "card_scale": "dynamic",
    "show_sidebar": false,
    "show_consoles_row": true,
    "show_modes_row": true,
    "show_genres_row": true,
    "show_favorites_row": true,
    "show_all_games_row": true
  },
  "assets": {
    "background_image": null,
    "logo_override": null,
    "startup_sound": null
  },
  "custom_css": "/* Style personnalisé pour Kaïro Hub */\n.theme-custom-glow {\n  filter: drop-shadow(0 0 10px rgba(99, 102, 241, 0.4));\n}"
}